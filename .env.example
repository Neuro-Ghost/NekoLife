# Copy this to .env and fill in your values.
# Get OAuth keys from each provider's developer console.

DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="replace-me-with-a-random-string-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email (for magic-link login — optional, uses nodemailer under the hood)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@neko-life.local"
